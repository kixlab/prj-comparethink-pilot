{
  "name": "prj-comparethink-pilot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format:check": "prettier --check src/pilot server tasks tests src/main.tsx vite.config.ts playwright.config.ts scripts/importPlanbench.mjs README.md"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.18.20",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "vite": "^4.5.0"
  }
}
