# Server only. Never prefix a credential with VITE_.
OPENAI_API_KEY=
# OpenAI default. For Bedrock, set its regional Responses API base URL and use a Bedrock API key above.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional project attribution, including Bedrock Mantle projects (OpenAI-Project header).
OPENAI_PROJECT=
# Keep fixed for each study. Prefer an explicit model snapshot for reproducibility.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=4096
# Optional. Omit settings unsupported by the selected model.
OPENAI_TEMPERATURE=
OPENAI_REASONING_EFFORT=

# Post-task STT is independent from the chat model and its key.
# off | local-whisper | api
STT_PROVIDER=off
STT_LANGUAGE=auto
# Local mode: reuse a whisper.cpp GGML model. Build the runner with bash scripts/setupLocalStt.sh.
STT_WHISPER_BIN=
STT_WHISPER_MODEL=
STT_FFMPEG_BIN=
# API mode: OpenAI-compatible /audio/transcriptions. Never reuse the Bedrock chat key here.
STT_API_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_API_MODEL=
# diarized_json / verbose_json for timed segments; json preserves text without inventing timestamps.
# whisper-1 supports verbose_json (not diarized_json). FFmpeg is still required in API mode.
STT_API_RESPONSE_FORMAT=diarized_json

# For an HTTPS reverse proxy, set the exact public origin (no trailing slash).
PILOT_PUBLIC_ORIGIN=
# `npm start` (vite preview) bind address. Keep 127.0.0.1 when the proxy runs on the same machine;
# use 0.0.0.0 only when the proxy forwards from another host.
PILOT_HOST=127.0.0.1
PILOT_PORT=4173
